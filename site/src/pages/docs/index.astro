---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import DocsSidebar from '../../components/DocsSidebar.astro';
import { sortDocs } from '../../lib/docs';

const docsEntries = sortDocs(await getCollection('docs'));
---

<Layout
	title="gaur docs - get started"
	description="Get started with gaur - install, configure, and master the terminal-native package manager for Arch Linux."
>
	<div class="flex flex-wrap max-w-7xl mx-auto min-h-[calc(100vh-4rem)]">
		<!-- Sidebar -->
		<DocsSidebar />

		<!-- Main Content Section -->
		<article class="flex-1 min-w-0 p-8 md:p-12 lg:p-16 overflow-hidden">
			<div class="max-w-4xl mx-auto">
				<header class="mb-16">
					<h1 class="text-4xl md:text-6xl font-extrabold text-primary mb-6 tracking-tight">docs</h1>
					<p class="text-xl text-muted/80 leading-relaxed max-w-2xl">
						everything you need to install, configure, and use gaur.
					</p>
				</header>

				<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
					{docsEntries.map(entry => (
						<a
							href={`/docs/${entry.id}`}
							class="group p-8 rounded-gaur border border-muted/20 bg-surface hover:border-primary/50 hover:shadow-glow transition-all duration-300"
						>
							<h2 class="text-2xl font-bold text-highlight group-hover:text-primary mb-3 transition-colors tracking-tight">
								{entry.data.title}
							</h2>
							<p class="text-text/70 text-base leading-relaxed">
								{entry.data.description}
							</p>
						</a>
					))}
				</div>

			<div class="mt-20 p-8 rounded-gaur border border-highlight/20 bg-highlight/5">
				<h3 class="text-xl font-bold text-highlight mb-4">quick start</h3>
				<p class="text-text/80 mb-6">grab gaur from the aur and you're ready to go. one command, zero fuss.</p>
				<div class="flex flex-wrap gap-4 mb-2">
					<button class="docs-qs-tab text-[10px] font-bold text-mauve tracking-widest uppercase transition-all hover:text-mauve" data-cmd="paru -S gaur-bin">
						[ paru ]
					</button>
					<button class="docs-qs-tab text-[10px] font-bold text-subtext0 tracking-widest uppercase transition-all hover:text-mauve" data-cmd="yay -S gaur-bin">
						[ yay ]
					</button>
					<button class="docs-qs-tab text-[10px] font-bold text-subtext0 tracking-widest uppercase transition-all hover:text-mauve" data-cmd="go install github.com/prbhtkumr/gaur@latest">
						[ go ]
					</button>
				</div>
				<div class="bg-crust border border-surface0 rounded-gaur p-3 md:p-4 flex flex-col md:flex-row items-center justify-between group shadow-xl gap-4">
					<div class="flex items-center gap-3 w-full md:w-auto">
						<span class="text-green font-bold">$</span>
						<code id="docs-qs-cmd" class="text-green/90 text-[11px] break-all">paru -S gaur-bin</code>
					</div>
					<button id="docs-qs-copy" class="w-full md:w-auto px-6 py-2 md:py-1 text-[10px] font-bold border border-mauve text-mauve hover:bg-mauve/10 transition-all rounded-gaur uppercase tracking-widest">
						COPY
					</button>
				</div>
			</div>
			</div>
		</article>
	</div>
</Layout>

<script>
	import { attachCopy } from '../../lib/clipboard';

	document.querySelectorAll<HTMLButtonElement>('.docs-qs-tab').forEach((btn) => {
		btn.addEventListener('click', () => {
			document.querySelectorAll<HTMLButtonElement>('.docs-qs-tab').forEach((b) => {
				b.classList.remove('text-mauve');
				b.classList.add('text-subtext0');
			});
			btn.classList.add('text-mauve');
			btn.classList.remove('text-subtext0');
			const cmdEl = document.getElementById('docs-qs-cmd');
			if (cmdEl && btn.dataset.cmd) cmdEl.textContent = btn.dataset.cmd;
		});
	});

	const copyBtn = document.getElementById('docs-qs-copy');
	if (copyBtn instanceof HTMLButtonElement) {
		attachCopy(copyBtn, () => document.getElementById('docs-qs-cmd')?.textContent, {
			pairs: [
				['text-green', 'text-mauve'],
				['border-green', 'border-mauve'],
			],
		});
	}
</script>
