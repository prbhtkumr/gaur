---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';

import catppuccinFrappe from '../assets/themes/catppuccin-frappe.png';
import catppuccinMacchiato from '../assets/themes/catppuccin-macchiato.png';
import catppuccinMocha from '../assets/themes/catppuccin-mocha.png';
import dracula from '../assets/themes/dracula.png';
import gruvboxDark from '../assets/themes/gruvbox-dark.png';
import monokaiPro from '../assets/themes/monokai-pro.png';
import oneDark from '../assets/themes/one-dark.png';
import rosePine from '../assets/themes/rose-pine.png';
import solarizedDark from '../assets/themes/solarized-dark.png';
import tokyonightNight from '../assets/themes/tokyonight-night.png';
import tokyonightStorm from '../assets/themes/tokyonight-storm.png';

const themes = [
    { name: 'catppuccin frappe', img: catppuccinFrappe },
    { name: 'catppuccin macchiato', img: catppuccinMacchiato },
    { name: 'catppuccin mocha', img: catppuccinMocha },
    { name: 'dracula', img: dracula },
    { name: 'gruvbox dark', img: gruvboxDark },
    { name: 'monokai pro', img: monokaiPro },
    { name: 'one dark', img: oneDark },
    { name: 'rose pine', img: rosePine },
    { name: 'solarized dark', img: solarizedDark },
    { name: 'tokyo night night', img: tokyonightNight },
    { name: 'tokyo night storm', img: tokyonightStorm },
];
---

<Layout
	title="gaur - themes"
	description="Color themes and screenshot gallery for the gaur terminal user interface on Arch Linux."
>
	<div class="max-w-6xl mx-auto px-4 py-20">
		<header class="text-center mb-20">
			<h1 class="text-4xl md:text-6xl font-bold mb-4">
				<span class="text-primary">pick your</span> palette
			</h1>
			<p class="text-muted text-lg max-w-2xl mx-auto">
				gaur ships with the most popular terminal themes baked in. 
				match your terminal colorscheme and keep your rice consistent.
			</p>
		</header>

		<div class="grid grid-cols-1 md:grid-cols-2 gap-12">
			{themes.map((theme) => (
				<div class="group relative">
					<!-- Hover Effect Background -->
					<div class="absolute -inset-1 bg-highlight/20 rounded-gaur blur opacity-0 group-hover:opacity-40 transition duration-500"></div>
					
					<div class="relative bg-surface border border-muted/20 rounded-gaur overflow-hidden transition-all duration-300 group-hover:border-highlight/50 shadow-xl group-hover:shadow-glow">
						<!-- Custom ASCII Header for Card -->
						<div class="px-4 py-2 border-b border-muted/10 bg-crust/50 flex items-center justify-between">
							<span class="text-[10px] text-muted font-bold tracking-widest uppercase">{theme.name}</span>
							<div class="flex gap-1">
								<div class="w-1.5 h-1.5 rounded-full bg-muted/20"></div>
								<div class="w-1.5 h-1.5 rounded-full bg-muted/20"></div>
							</div>
						</div>
						
							<div class="p-2">
								<Image
									src={theme.img}
									alt={`${theme.name} theme in gaur`}
									width={1068}
									height={772}
									format="webp"
									quality={82}
									widths={[480, 760, 1068]}
									sizes="(min-width: 1024px) 33vw, (min-width: 768px) 48vw, calc(100vw - 2rem)"
									loading="lazy"
									class="w-full h-auto rounded-sm shadow-inner"
								/>
							</div>
					</div>
				</div>
			))}
		</div>

		<div class="mt-20 text-center border-t border-muted/10 pt-12">
			<p class="text-muted text-sm italic">
				&gt; don't see your theme? prs welcome, adding one takes five minutes.
			</p>
		</div>
	</div>
</Layout>
