---
import type { CollectionEntry } from 'astro:content';

interface Props {
	entries: CollectionEntry<'docs'>[];
	currentSlug?: string;
}

const { entries, currentSlug } = Astro.props;

const row =
	'relative flex items-center rounded-gaur px-3 py-2 text-sm font-medium transition-all duration-150';
const idle = 'text-text/70 hover:text-text hover:bg-white/[0.06] shadow-[inset_0_1px_0_rgba(255,255,255,0.05)]';
const active = 'text-primary bg-white/[0.07] shadow-[inset_0_1px_0_rgba(255,255,255,0.08)]';
---

<div>
	<h3 class="text-xs font-bold text-muted uppercase tracking-widest mb-3 pl-3">guides</h3>
	<ul class="space-y-1">
		{entries.map((entry) => (
			<li>
				<a
					href={`/docs/${entry.id}`}
					class:list={[row, currentSlug === entry.id ? active : idle]}
					aria-current={currentSlug === entry.id ? 'page' : undefined}
				>
					{currentSlug === entry.id && (
						<span class="absolute left-0 top-1/2 h-3.5 w-0.5 -translate-y-1/2 rounded-full bg-primary" aria-hidden="true"></span>
					)}
					{entry.data.title}
				</a>
			</li>
		))}
	</ul>
</div>

<div class="pt-6 border-t border-white/[0.07]">
	<h3 class="text-xs font-bold text-muted uppercase tracking-widest mb-3 pl-3">links</h3>
	<ul class="space-y-1">
		<li>
			<a href="https://github.com/prbhtkumr/gaur/issues" class:list={[row, idle]}>file an issue</a>
		</li>
		<li>
			<a href="https://github.com/prbhtkumr/gaur" class:list={[row, idle]}>source code</a>
		</li>
	</ul>
</div>
