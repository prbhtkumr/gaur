---
import { getCollection } from 'astro:content';
import { sortDocs } from '../lib/docs';
import DocsNavList from './DocsNavList.astro';

const docsEntries = sortDocs(await getCollection('docs'));

interface Props {
	currentSlug?: string;
}

const { currentSlug } = Astro.props;
---

<!-- Mobile: disclosure at the top of the docs column (below md) -->
<details class="md:hidden w-full order-first border-b border-muted/10 bg-crust/40">
	<summary class="cursor-pointer px-6 py-4 text-xs font-bold text-muted uppercase tracking-widest select-none">
		guides
	</summary>
	<nav aria-label="Documentation" class="px-6 pb-6 pt-2 space-y-8">
		<DocsNavList entries={docsEntries} currentSlug={currentSlug} />
	</nav>
</details>

<!-- Desktop: persistent sidebar -->
<aside class="w-64 flex-shrink-0 border-r border-muted/10 hidden md:block">
	<nav aria-label="Documentation" class="sticky top-24 p-8 space-y-8">
		<DocsNavList entries={docsEntries} currentSlug={currentSlug} />
	</nav>
</aside>
