---
import { getCollection } from 'astro:content';
import { sortDocs } from '../lib/docs';
import DocsNavList from './DocsNavList.astro';

const docsEntries = sortDocs(await getCollection('docs'));

interface Props {
	currentSlug?: string;
}

const { currentSlug } = Astro.props;
---

<!-- Mobile: frosted disclosure at the top of the docs column (below md) -->
<details class="glass rounded-gaur disclosure md:hidden w-full order-first">
	<summary class="cursor-pointer px-5 py-4 text-xs font-bold text-muted uppercase tracking-widest select-none">
		guides
	</summary>
	<nav aria-label="Documentation" class="px-4 pb-5 pt-1 space-y-6">
		<DocsNavList entries={docsEntries} currentSlug={currentSlug} />
	</nav>
</details>

<!-- Desktop: frosted rail -->
<aside class="w-64 shrink-0 hidden md:block">
	<nav aria-label="Documentation" class="sticky top-24 p-4">
		<div class="glass rounded-gaur p-4 space-y-6">
			<DocsNavList entries={docsEntries} currentSlug={currentSlug} />
		</div>
	</nav>
</aside>
